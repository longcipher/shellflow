#!/usr/bin/env bash
# Mock `ssh` for integration tests.
#
# Records argv and stdin for later assertion, then behaves per invocation:
#   `-V`            -> print version, exit 0 (preflight probe)
#   host *echo*     -> echo stdin back on stdout (lets tests observe payload)
#   host *ok*       -> exit 0
#   host *fail*     -> exit 7 after printing a message to stderr
#   host *hang*     -> sleep forever (used with --timeout)
#   default         -> exit 255 (simulates an ssh connection failure)
set -u

MOCK_DIR="${MOCK_DIR:?MOCK_DIR not set}"
LOG="$MOCK_DIR/ssh.log"

printf 'ARGS: %s\n' "$*" >> "$LOG"

# Preflight probe: `ssh -V`. Must succeed without touching stdin.
for arg in "$@"; do
  if [[ "$arg" == "-V" ]]; then
    echo "OpenSSH mock 9.0" >&2
    exit 0
  fi
done

# The destination is the first non-flag argument (e.g. `ssh host -T bash -s`).
# Options that take a separate value (`-o BatchMode=yes`) must not be mistaken
# for the destination, so the value is skipped too.
host=""
skip_next=0
for arg in "$@"; do
  if [[ "$skip_next" == "1" ]]; then
    skip_next=0
    continue
  fi
  case "$arg" in
    -o|-p|-i|-F|-l|-c|-m|-b|-D|-L|-R|-W|-e|-S|-J|-I) skip_next=1 ;;
    -*) ;;
    *)
      host="$arg"
      break
      ;;
  esac
done
printf 'HOST: %s\n' "$host" >> "$LOG"

# Login-environment probe (`ssh host <PROBE_SCRIPT>`): answer immediately so
# tests never hit the host-specific behavior below. Line 1 = login shell
# (zsh for hosts with `zsh` in the name, bash otherwise), line 2 = the PATH
# (the mock PATH, so tests can assert the PATH injection into payloads),
# line 3 = `SHELLFLOW_HAS_RSYNC` when the host provides rsync (the `norsync`
# host deliberately omits it to exercise the scp fallback).
#
# The probe ends with `SHELLFLOW_PROBE_END`: the login shell and the PATH
# are usable even on a host *without* rsync, and the marker — not the exit
# status — is what says the probe completed. A host without rsync exits
# non-zero, mirroring a real `command -v rsync && …` probe.
if [[ " $*" == *'$SHELL'* && " $*" == *'$PATH'* ]]; then
  case "$host" in
    *zsh*) printf '/usr/bin/zsh\n' ;;
    *)     printf '/usr/bin/bash\n' ;;
  esac
  printf 'SHELLFLOW_PATH_BEGIN\n'
  printf '%s\n' "$PATH" | tr ':' '\n' | while IFS= read -r d; do
    if [ -n "$d" ] && [ -d "$d" ]; then printf '%s\n' "$d"; fi
  done
  printf 'SHELLFLOW_PATH_END\n'
  case "$host" in
    *norsync*) ;;
    *) printf 'SHELLFLOW_HAS_RSYNC\n' ;;
  esac
  printf 'SHELLFLOW_PROBE_END\n'
  case "$host" in
    *norsync*) exit 1 ;;
    *) exit 0 ;;
  esac
fi

# The `@wait_active` poll: `systemctl is-active` exits 0 only for an active
# unit, so the exit status is the verdict.
if [[ " $*" == *"systemctl is-active"* ]]; then
  case "$host" in
    *running*) exit 0 ;;
    *hang*)
      # Record this process's pid so a test can assert that an interrupt left
      # no orphaned process group behind.
      printf '%s\n' "$$" >> "$MOCK_DIR/ssh.pids"
      sleep 300
      exit 0
      ;;
    *) exit 3 ;;
  esac
fi

# Persist whatever was piped to us so tests can assert on the payload.
cat > "$MOCK_DIR/ssh-stdin-$host.txt"

# A framed batch (`shellflow host …` / `service check` / `service diff`):
# the script asks several questions and frames each answer between markers.
# Answer every question, so the batch transport (which parses the answers
# as they stream in) is exercised end to end.
if grep -q '__SFW_' "$MOCK_DIR/ssh-stdin-$host.txt" 2>/dev/null; then
  grep -o '__SFW_[A-Za-z0-9_]*_B_[A-Za-z0-9_.-]*' "$MOCK_DIR/ssh-stdin-$host.txt" \
    | sort -u | while IFS= read -r beg; do
        end="${beg/_B_/_E_}"
        id="${beg##*_B_}"
        printf '%s 0\n' "$beg"
        printf 'mock answer for %s\n' "$id"
        printf '%s\n' "$end"
      done
  exit 0
fi

case "$host" in
  *norsync*)
    # Host without rsync: the rsync probe (`command -v rsync`) must fail,
    # while real commands succeed — forces the scp fallback path.
    if [[ " $* " == *"command -v rsync"* ]]; then
      echo "command not found: rsync" >&2
      exit 1
    fi
    exit 0
    ;;
  *echo*)
    # Re-emit the recorded payload so tests can observe streamed output.
    # A rendezvous barrier makes fan-out observable without wall-clock races:
    # concurrent hosts both announce READY before either announces DONE
    # (READY,READY,DONE,DONE); a serialized run interleaves
    # (READY,DONE,READY,DONE).
    #
    # The wait is bounded, so a *serialized* run — where only ever one host
    # stands at the barrier — still makes progress. The bound is generous by
    # default (a busy machine must not turn a concurrent run into a false
    # negative) and is shortened by the tests that assert the serialized
    # order, which are the only ones that pay for it.
    echo "READY-$host" >> "$MOCK_DIR/order.log"
    wait_ms="${MOCK_BARRIER_WAIT_MS:-5000}"
    waited=0
    while [ "$waited" -lt "$wait_ms" ]; do
      ready_count=$(grep -c '^READY-' "$MOCK_DIR/order.log" 2>/dev/null || true)
      [ -z "$ready_count" ] && ready_count=0
      [ "$ready_count" -ge 2 ] && break
      sleep 0.05
      waited=$((waited + 50))
    done
    echo "DONE-$host" >> "$MOCK_DIR/order.log"
    cat "$MOCK_DIR/ssh-stdin-$host.txt"
    exit 0
    ;;
  *ok*)
    exit 0
    ;;
  *zsh*)
    # Login shell is zsh; a plain payload run succeeds.
    exit 0
    ;;
  *fail*)
    echo "mock: intentional failure" >&2
    exit 7
    ;;
  *hang*)
    # Record this process's pid so a test can assert that an interrupt left
    # no orphaned process group behind.
    printf '%s\n' "$$" >> "$MOCK_DIR/ssh.pids"
    sleep 300
    exit 0
    ;;
  *)
    echo "ssh: connect to host $host port 22: Operation timed out" >&2
    exit 255
    ;;
esac
