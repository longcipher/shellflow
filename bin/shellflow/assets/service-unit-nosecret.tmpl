[Unit]
Description=__SVC__ (infra managed, no secrets)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# TODO: set the runtime user. Keep the current one for phase 1 (behavior
# preservation); migrate to a dedicated user separately.
# User=__SVC__
# Group=__SVC__
ExecStart=/opt/__SVC__/bin/__SVC__
Restart=on-failure
RestartSec=5

# --- Security hardening: keep it inline in this unit. ---

[Install]
WantedBy=multi-user.target
