#!/usr/bin/env bash
# shellflow demo starter: export systemd credentials as environment variables,
# then exec the real binary.
#
# This is the per-service form of the cred-wrap pattern (design §8.4): the
# wrapper ships in the service's own `bin/` directory and is installed to
# /opt/<svc>/bin/, so each service carries its own copy — there is no global
# helper to keep in sync. Units use it as an ExecStart prefix:
#
#   [Service]
#   ImportCredential=API_KEY
#   ExecStart=/opt/demo-secret-app/bin/demo-secret-app-start
#
# It exports every file in $CREDENTIALS_DIRECTORY using the filename as the
# variable name, then execs the real binary. Security properties match the
# in-app loader: values live only in the unit's read-only tmpfs credential
# directory, are bound to the host key, and are destroyed with the unit.
set -eu

if [ -n "${CREDENTIALS_DIRECTORY:-}" ]; then
  for f in "$CREDENTIALS_DIRECTORY"/*; do
    [ -f "$f" ] || continue
    key="$(basename "$f")"
    case "$key" in
      [A-Za-z_][A-Za-z0-9_]*) ;;
      *) continue ;;
    esac
    export "$key=$(cat "$f")"
  done
fi

exec /opt/demo-secret-app/bin/demo-secret-app "$@"
