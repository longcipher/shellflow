[Unit]
Description=Demo Secret App — credential→env via a per-service starter (third-party app pattern)
After=network-online.target
Wants=network-online.target

# === Per-service starter: For third-party / closed-source applications ===
#
# Many open-source projects read sensitive configuration from environment
# variables only. They cannot be modified to use systemd's LoadCredential=
# API directly.
#
# Solution: the `demo-secret-app-start` wrapper shipped in this service's
# `bin/` directory. It reads systemd credentials from
# $CREDENTIALS_DIRECTORY, exports them as environment variables, then execs
# the real binary. No application code changes needed.
#
# Security properties:
#   - Credentials are host-key-bound encrypted (systemd-creds encrypt --with-key=host)
#   - Stored in /etc/credstore.encrypted/ (0700 root:root)
#   - Decrypted into a tmpfs only for the unit's lifetime
#   - Never touch disk as plaintext on the target
#
# The credential store is created by the deploy playbook automatically.

[Service]
Type=oneshot
# Ephemeral uid/gid per start: no static `nobody` account (which systemd
# flags as unsafe), no state left behind between runs.
DynamicUser=yes

# demo-secret-app-start: export systemd credentials as env vars, then exec
ExecStart=/opt/demo-secret-app/bin/demo-secret-app-start

# Import credentials from the host-key-bound encrypted store.
# Each ImportCredential=KEY resolves to /etc/credstore.encrypted/KEY.
ImportCredential=API_KEY
ImportCredential=API_SECRET
ImportCredential=DB_PASSWORD

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
