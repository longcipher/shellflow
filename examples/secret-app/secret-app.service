[Unit]
Description=Secret App example — credential→env via the shared cred-env helper (third-party app pattern)
After=network-online.target
Wants=network-online.target

# === Per-service starter replacement: the shared `cred-env` helper ===
#
# Third-party / closed-source applications that read sensitive configuration
# from environment variables cannot be modified to use systemd's credential
# API directly. Instead of a per-service wrapper script, every service
# references the shellflow binary that the deploy playbook installs once per
# host (/usr/local/bin/shellflow):
#
#   [Service]
#   LoadCredentialEncrypted=API_KEY:/etc/credstore.encrypted/<svc>/API_KEY
#   ExecStart=/usr/local/bin/shellflow cred-env exec /opt/<svc>/bin/<svc>
#
# `cred-env exec` exports every file in $CREDENTIALS_DIRECTORY (filename =
# variable name) and then execs the real binary. No application code changes,
# and no per-service script to keep in sync. (`shellflow emit cred-env` still
# prints a bash-only fallback for targets that cannot host the binary.)
#
# Security properties:
#   - Credentials are host-key-bound encrypted (systemd-creds encrypt --with-key=host)
#   - Stored in /etc/credstore.encrypted/secret-app/ (0700 root:root)
#   - Decrypted into a tmpfs only for the unit's lifetime
#   - Never touch disk as plaintext on the target
#
# The credential store is created by the deploy playbook automatically
# (`shellflow cred-env credstore-install secret-app`).

[Service]
Type=oneshot
# Stay "active" after a successful run so `systemctl is-active` reflects the
# last run's outcome (exit 0 -> active, exit 1 -> failed).
RemainAfterExit=yes
# Ephemeral uid/gid per start: no static `nobody` account (which systemd
# flags as unsafe), no state left behind between runs.
DynamicUser=yes

# `shellflow cred-env exec` (the installed shellflow binary) exports systemd
# credentials as env vars, then execs the app — no per-service starter script.
ExecStart=/usr/local/bin/shellflow cred-env exec /opt/secret-app/bin/secret-app

# Import credentials from the per-service host-key-bound encrypted store.
# `ImportCredential=KEY` only searches the flat credential-store directories,
# and plain `LoadCredential=` expects a plaintext source — the path form that
# *decrypts* an encrypted credential is `LoadCredentialEncrypted=ID:PATH`
# (systemd.io/CREDENTIALS, systemd.exec(5)). The per-service sub-directory
# also keeps one service's deploy from wiping another's credentials.
# Generate these lines with:
#   shellflow secret creds --store-dir /etc/credstore.encrypted/secret-app <file.env.age>
LoadCredentialEncrypted=API_KEY:/etc/credstore.encrypted/secret-app/API_KEY
LoadCredentialEncrypted=API_SECRET:/etc/credstore.encrypted/secret-app/API_SECRET
LoadCredentialEncrypted=DB_PASSWORD:/etc/credstore.encrypted/secret-app/DB_PASSWORD

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
